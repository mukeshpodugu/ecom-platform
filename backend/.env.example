# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
# Leave MONGO_URI blank or set USE_MOCK_DB=true to use the automatic local JSON storage fallback
MONGO_URI=mongodb://localhost:27017/ecom-platform
USE_MOCK_DB=false

# Authentication configuration
JWT_SECRET=super_secret_key_for_jwt_token_generation_change_in_production
JWT_EXPIRE=30d

# Mock Cloudinary configuration
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret

# Mock Stripe/Razorpay configuration
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_razorpay_secret

# Email setup (for forgot password/verification notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_password
FROM_EMAIL=noreply@ecomplatform.com
